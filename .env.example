AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Optional if you use a table name instead of a table id.
AIRTABLE_TABLE_NAME=
# Optional comma-separated list of every manufacturing table to read in the queue.
AIRTABLE_TABLES=
# Optional queue-only allowlist. If set, this overrides AIRTABLE_TABLES and category routing for queue reads.
AIRTABLE_QUEUE_TABLES=
# Optional view name or view id used when reading queue records from each table.
AIRTABLE_QUEUE_VIEW=To manufacture
# Optional category-to-table routing. Values can be table IDs or exact table names.
AIRTABLE_TABLE_ROBOT=
AIRTABLE_TABLE_SPARES=
# Optional JSON alternative, for example {"Robot":"Subsystem part tracking","Spares":"Spares Tracking"}.
AIRTABLE_CATEGORY_TABLE_MAP=
# Optional direct Airtable base/table URL used to build record links in Slack/UI.
# For multi-table setups, prefer leaving this blank so links are built per table.
AIRTABLE_BASE_URL=

ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=https://cheesy-parts.vercel.app/oauthRedirect
# Optional overrides. Defaults are Onshape production endpoints.
ONSHAPE_AUTHORIZATION_URL=https://oauth.onshape.com/oauth/authorize
ONSHAPE_TOKEN_URL=https://oauth.onshape.com/oauth/token
ONSHAPE_API_BASE_URL=https://cad.onshape.com/api

SLACK_MANUFACTURING_WEBHOOK_URL=
SLACK_STATUS_WEBHOOK_URL=
SLACK_3DP_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_MANUFACTURING_USERGROUP_ID=
# Optional. Used when SLACK_MANUFACTURING_USERGROUP_ID is not set.
SLACK_MANUFACTURING_USERGROUP_HANDLE=design,design-rooks
# Optional local fallback list, comma-separated as U123:Display Name,U456:Display Name.
SLACK_MANUFACTURING_FALLBACK_USERS=

# Optional local development upload path. Defaults to .data/uploads.
# On Vercel without this set, temporary uploads use /tmp and are not durable.
UPLOADS_DIR=
# Optional local request-store path. Defaults to .data locally and /tmp on Vercel.
# Production deployments should use Airtable instead of this fallback.
LOCAL_DATA_DIR=
