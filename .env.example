AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Optional if you use a table name instead of a table id.
AIRTABLE_TABLE_NAME=
# Optional direct Airtable base/table URL used to build record links in Slack/UI.
AIRTABLE_BASE_URL=

SLACK_MANUFACTURING_WEBHOOK_URL=
SLACK_STATUS_WEBHOOK_URL=
SLACK_3DP_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_MANUFACTURING_USERGROUP_ID=
# Optional. Used when SLACK_MANUFACTURING_USERGROUP_ID is not set.
SLACK_MANUFACTURING_USERGROUP_HANDLE=manufacturing
# Optional local fallback list, comma-separated as U123:Display Name,U456:Display Name.
SLACK_MANUFACTURING_FALLBACK_USERS=

# Optional local development upload path. Defaults to .data/uploads.
UPLOADS_DIR=
